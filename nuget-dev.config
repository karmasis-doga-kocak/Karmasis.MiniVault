<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet config used by the CI pipeline (azure-pipelines.yml) to restore on dev/feature
  branches. Mirrors the pattern in Karmasis.Cryptography's azure-pipelines.yml /
  nuget-dev.config: nuget.org plus both the dev and release Karmasis private feeds, so a
  package published to either while iterating can be restored. It intentionally does NOT
  include the developer-only "karmasis-local" folder feed from the root nuget.config (see
  that file) - a folder path outside the repo does not exist on a build agent.

  NOTE: as of this branch, Karmasis.MiniVault.Client references Karmasis.Cryptography
  26.3.0-dek.1, which is only published to the local folder feed (see docs/client.md,
  "Release prerequisites"). Restoring this solution with this config will FAIL until that
  package (or a stable release with a netstandard2.0 target) is pushed to artifactrepo or
  artifactrepodev. See the top-of-file note in azure-pipelines.yml.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="artifactrepo" value="https://pkgs.dev.azure.com/karmasisdm/_packaging/artifactrepo/nuget/v3/index.json" />
    <add key="artifactrepodev" value="https://pkgs.dev.azure.com/karmasisdm/_packaging/artifactrepodev/nuget/v3/index.json" />
  </packageSources>
</configuration>
