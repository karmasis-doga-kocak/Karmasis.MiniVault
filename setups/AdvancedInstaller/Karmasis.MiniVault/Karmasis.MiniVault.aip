<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Karmasis MiniVault - Advanced Installer project.

  Authored by hand (Advanced Installer 22.x XML), adapted from
  Karmasis.Classic.DataskopeCollector/setups/AdvancedInstaller/DAM.Collector/DAM.Collector.aip.
  It has NOT been opened in the Advanced Installer designer or built into an MSI yet; see
  ../README.md for the build order and what the first designer session has to verify.

  Differences from the Collector project worth knowing about:
    * No .NET Framework launch condition - MiniVault publishes self-contained (win-x64).
    * The payload is a SynchronizedFolderComponent over the publish output, so the file list is
      resolved by Advanced Installer at build time instead of being enumerated here.
    * Four configuration pages (SqlDlg, ServiceDlg, TlsDlg, RecoveryDlg) sit between FolderDlg and
      VerifyReadyDlg on a first install and fill the MV_* properties; an unattended install sets
      the same properties on the msiexec command line and never sees them.
-->
<DOCUMENT Type="Advanced Installer" CreateVersion="22.8" version="22.8" PreviousModules="professional" Modules="professional" RootPath="." Language="en" Id="{1E3F7656-2DD8-4374-B57E-9777FCB215B4}">
  <COMPONENT cid="caphyon.advinst.msicomp.ProjectOptionsComponent">
    <ROW Name="HiddenItems" Value="ActSyncAppComponent;CPLAppletComponent;AutorunComponent;GameUxComponent;SilverlightSlnComponent;SharePointSlnComponent"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiPropsComponent">
    <ROW Property="AI_BITMAP_DISPLAY_MODE" Value="0"/>
    <ROW Property="AI_PRODUCTNAME_ARP" Value="[|ProductName]"/>
    <ROW Property="AI_UNINSTALLER" Value="msiexec.exe"/>
    <ROW Property="ALLUSERS" Value="1"/>
    <ROW Property="ARPCOMMENTS" Value="This installer database contains the logic and data required to install [|ProductName]." ValueLocId="*"/>
    <ROW Property="ARPSYSTEMCOMPONENT" Value="1"/>
    <ROW Property="AiEmbeddedUI" Value="1" MultiBuildValue="DefaultBuild:"/>
    <ROW Property="BannerBitmap" Value="banner.bmp" MultiBuildValue="DefaultBuild:banner.bmp" Type="1" MsiKey="BannerBitmap"/>
    <ROW Property="DialogBitmap" Value="background.bmp" MultiBuildValue="DefaultBuild:background.bmp" Type="1" MsiKey="DialogBitmap"/>
    <ROW Property="DisplayName" Value="Karmasis MiniVault"/>
    <ROW Property="Manufacturer" Value="Karmasis"/>
    <ROW Property="ProductCode" Value="1033:{60F58B69-8AE2-48EE-918D-B223CEE15D2D} " Type="16"/>
    <ROW Property="ProductLanguage" Value="1033"/>
    <ROW Property="ProductName" Value="Karmasis MiniVault"/>
    <ROW Property="ProductVersion" Value="0.1.0" Options="32"/>
    <ROW Property="ServiceName" Value="KarmasisMiniVault"/>
    <ROW Property="UpgradeCode" Value="{49C997F8-49AB-40B5-B736-4D4D59CA7762}"/>
    <!-- MV_* are the installer's public inputs. Every one of them is listed in
         SecureCustomProperties so msiexec keeps it across the elevated/deferred boundary. Every
         secret is listed in MsiHiddenProperties - and so are the deferred actions' own names,
         because a deferred action's CustomActionData is logged under a property with the same name
         as the action, and that data carries the connection string, the certificate password and
         the master-key password. Hiding only the MV_* properties would leave all three in a /l*v
         log. -->
    <ROW Property="MV_CONNECTIONSTRING" Value=""/>
    <ROW Property="MV_SERVICEACCOUNT" Value="LocalSystem"/>
    <ROW Property="MV_SERVICEACCOUNT_PASSWORD" Value=""/>
    <ROW Property="MV_RECOVERY" Value="single"/>
    <ROW Property="MV_SHARES" Value="3"/>
    <ROW Property="MV_THRESHOLD" Value="2"/>
    <ROW Property="MV_MASTERKEY" Value=""/>
    <ROW Property="MV_CERT_PATH" Value=""/>
    <ROW Property="MV_CERT_PASSWORD" Value=""/>
    <ROW Property="MV_CERT_THUMBPRINT" Value=""/>
    <ROW Property="MV_URL" Value="https://0.0.0.0:8200"/>
    <ROW Property="MV_RECONFIGURE" Value=""/>
    <ROW Property="MV_SQL_OK" Value="0"/>
    <ROW Property="MV_SQL_ERROR" Value=""/>
    <!-- UI-only properties: read by the configuration dialogs, never by a custom action. The check
         boxes hold "1" when ticked and are cleared (removed) when unticked - see MsiCheckBoxComponent.
         MV_MASTERKEY_CONFIRM repeats the master-key password, so it is hidden like MV_MASTERKEY;
         MV_UI_ERROR carries the message MvErrorDlg shows when a page's Next button rejects the input. -->
    <ROW Property="MV_MASTERKEY_USEPASSWORD" Value=""/>
    <ROW Property="MV_MASTERKEY_CONFIRM" Value=""/>
    <ROW Property="MV_CERT_USEPFX" Value=""/>
    <ROW Property="MV_RECOVERY_ACK" Value=""/>
    <ROW Property="MV_UI_ERROR" Value=""/>
    <ROW Property="MsiHiddenProperties" Value="MV_CONNECTIONSTRING;MV_CERT_PASSWORD;MV_MASTERKEY;MV_MASTERKEY_CONFIRM;MV_SERVICEACCOUNT_PASSWORD;WriteMachineConfig;RunInit"/>
    <ROW Property="SecureCustomProperties" Value="OLDPRODUCTS;AI_NEWERPRODUCTFOUND;MV_CONNECTIONSTRING;MV_SERVICEACCOUNT;MV_SERVICEACCOUNT_PASSWORD;MV_RECOVERY;MV_SHARES;MV_THRESHOLD;MV_MASTERKEY;MV_CERT_PATH;MV_CERT_PASSWORD;MV_CERT_THUMBPRINT;MV_URL;MV_RECONFIGURE;MV_SQL_OK;MV_SQL_ERROR"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiDirsComponent">
    <ROW Directory="APPDIR" Directory_Parent="TARGETDIR" DefaultDir="APPDIR:." IsPseudoRoot="1"/>
    <ROW Directory="TARGETDIR" DefaultDir="SourceDir"/>
    <ROW Directory="TempFolder" Directory_Parent="TARGETDIR" DefaultDir="TEMPFO~1|TempFolder" IsPseudoRoot="1"/>
    <ROW Directory="ProductCode_Dir" Directory_Parent="TempFolder" DefaultDir="{2E07C~1|[|ProductCode]"/>
    <ROW Directory="CommonAppDataFolder" Directory_Parent="TARGETDIR" DefaultDir="COMMON~1|CommonAppDataFolder" IsPseudoRoot="1"/>
    <ROW Directory="MiniVaultData_Dir" Directory_Parent="CommonAppDataFolder" DefaultDir="MiniVault"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiCompsComponent">
    <ROW Component="AI_CustomARPName" ComponentId="{F3B949D5-5057-405D-B94A-754129DC672B}" Directory_="APPDIR" Attributes="260" KeyPath="DisplayName" Options="1"/>
    <!-- Attributes carry 256 = msidbComponentAttributes64bit on every component: the package is x64
         (BuildComponent MsiPackageType="x64"), so its components must be marked 64-bit or ICE80 fails
         the validation and the registry rows would be redirected to the WOW6432Node hive. -->
    <ROW Component="APPDIR" ComponentId="{765CBC34-C924-4D3B-8A21-9249376F04FE}" Directory_="APPDIR" Attributes="256"/>
    <ROW Component="ProductInformation" ComponentId="{002B0E32-78B5-4B3F-AA0A-32A8E1388DEE}" Directory_="APPDIR" Attributes="260" KeyPath="Path"/>
    <ROW Component="minivault.exe" ComponentId="{69D25E48-E926-4F70-BED3-E4A7A755C8FE}" Directory_="APPDIR" Attributes="256" KeyPath="minivault.exe"/>
    <!-- %ProgramData%\MiniVault: created by the MSI, permissions applied by LockPermissions and
         then re-applied by the WriteMachineConfig custom action (same grants as install.ps1).
         Attributes 16 = msidbComponentAttributesPermanent: an uninstall leaves the folder, and with
         it appsettings.json and the DPAPI-protected master key, in place. 272 = 256 (64-bit) + 16. -->
    <ROW Component="MiniVaultData" ComponentId="{039355A6-1236-4CBD-A9E8-9CF539019A31}" Directory_="MiniVaultData_Dir" Attributes="272"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiFeatsComponent">
    <ROW Feature="MainFeature" Title="MainFeature" Description="Karmasis MiniVault server" Display="1" Level="1" Directory_="APPDIR" Attributes="0"/>
    <ATTRIBUTE name="CurrentFeature" value="MainFeature"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiFilesComponent">
    <!-- minivault.exe is listed here, and excluded from the SynchronizedFolderComponent at the end of
         this file, so that exactly one row owns it. It cannot simply be left to the synchronized
         folder: ServiceInstall/ServiceControl/ServiceConfig all hang off a component whose KeyPath is
         this file, and the components a synchronized folder creates at build time have generated
         names that nothing here could reference. Every other file in the publish output does come
         from the synchronized folder. -->
    <ROW File="minivault.exe" Component_="minivault.exe" FileName="minivault.exe" Attributes="0" SourcePath="..\..\..\src\MiniVault.Server\bin\publish\win-x64\minivault.exe" SelfReg="false" DigSign="true"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiFeatCompsComponent">
    <ROW Feature_="MainFeature" Component_="APPDIR"/>
    <ROW Feature_="MainFeature" Component_="AI_CustomARPName"/>
    <ROW Feature_="MainFeature" Component_="ProductInformation"/>
    <ROW Feature_="MainFeature" Component_="minivault.exe"/>
    <ROW Feature_="MainFeature" Component_="MiniVaultData"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiCreateFolderComponent">
    <ROW Directory_="APPDIR" Component_="APPDIR" ManualDelete="true"/>
    <ROW Directory_="MiniVaultData_Dir" Component_="MiniVaultData"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiLockPermissionsComponent">
    <!-- 268435456 = GENERIC_ALL. SIDs are used instead of names because the group names are
         localized. The WriteMachineConfig custom action applies the same two ACEs (plus a
         read/execute ACE for a non-LocalSystem service account) after the files are installed. -->
    <ROW LockObject="MiniVaultData_Dir" Table="CreateFolder" Domain="" User="S-1-5-18" Permission="268435456"/>
    <ROW LockObject="MiniVaultData_Dir" Table="CreateFolder" Domain="" User="S-1-5-32-544" Permission="268435456"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiServInstComponent">
    <!-- Password is empty for the built-in accounts (LocalSystem, NT AUTHORITY\NetworkService, ...) and
         carries MV_SERVICEACCOUNT_PASSWORD for a domain or local user account. The property is hidden
         from the MSI log; MSI itself never writes the ServiceInstall Password column to the log. -->
    <ROW ServiceInstall="minivault.exe" Name="[ServiceName]" DisplayName="[DisplayName]" ServiceType="16" StartType="2" ErrorControl="1" StartName="[MV_SERVICEACCOUNT]" Password="[MV_SERVICEACCOUNT_PASSWORD]" Component_="minivault.exe" Description="Karmasis MiniVault secret vault server."/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiServCtrlComponent">
    <!-- Event 163 = 0x01 start on install + 0x02 stop on install + 0x20 stop on uninstall +
         0x80 delete on uninstall; Wait=1. The 0x01 bit is what actually starts the service at the end
         of the installation - without it the MSI installed a service that never ran, and the 0x02 bit
         is what stops the running service before an upgrade replaces its files. -->
    <ROW ServiceControl="minivault.exe" Name="[ServiceName]" Event="163" Wait="1" Component_="minivault.exe"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiServConfigComponent">
    <ROW MsiServiceConfig="ServiceName" Name="[ServiceName]" Event="1" ConfigType="4" Argument="1" Component_="minivault.exe"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiServConfigFailureActionsComponent">
    <!-- Restart three times, 5 s apart, same as 'sc.exe failure ... actions= restart/5000/...'. -->
    <ROW MsiServiceConfigFailureActions="ServiceName" Name="[ServiceName]" Event="1" ResetPeriod="86400" RebootMessage="[~]" Actions="1[~]1[~]1" DelayActions="5000[~]5000[~]5000" Component_="minivault.exe"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiBinaryComponent">
    <ROW Name="DotNetMethodCaller.dll" SourcePath="&lt;AI_CUSTACTS&gt;DotNetMethodCaller.dll"/>
    <ROW Name="ExternalUICleaner.dll" SourcePath="&lt;AI_CUSTACTS&gt;ExternalUICleaner.dll"/>
    <ROW Name="aicustact.dll" SourcePath="&lt;AI_CUSTACTS&gt;aicustact.dll"/>
    <ROW Name="tempFiles.dll" SourcePath="&lt;AI_CUSTACTS&gt;tempFiles.dll"/>
    <ROW Name="background.bmp" SourcePath="..\img\background.bmp"/>
    <ROW Name="banner.bmp" SourcePath="..\img\banner.bmp"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.TempFileComponent">
    <!-- The managed custom-actions assembly cannot be a Binary-table DLL custom action (it has no
         native entry point), so - exactly as the Collector project does - it is extracted to
         %TEMP%\[ProductCode]\ and invoked through Advanced Installer's DotNetMethodCaller.dll.
         These two paths are what verify-aip.ps1 checks against the project's output folder. -->
    <ROW FileId="karmasis.minivault.customactions.dl" Name="KARMAS~1.DLL|Karmasis.MiniVault.CustomActions.dll" Directory_="ProductCode_Dir" Property="AI_KARMASIS.MINIVAULT.CUSTOMACTIONS.DL" Options="0" Data="..\Karmasis.MiniVault.CustomActions\bin\Release\Karmasis.MiniVault.CustomActions.dll"/>
    <ROW FileId="karmasis.advancedinstallerkit.dll" Name="KARMAS~2.DLL|Karmasis.AdvancedInstallerKit.dll" Directory_="ProductCode_Dir" Property="AI_KARMASIS.ADVANCEDINSTALLERKIT.DLL" Options="0" Data="..\Karmasis.MiniVault.CustomActions\bin\Release\Karmasis.AdvancedInstallerKit.dll"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiCustActComponent">
    <!-- Type 51 property setters. For a deferred action the property name must equal the action
         name; that is how MSI hands it its CustomActionData. The '|[&amp;fileid]|Type.Method' tail is
         what DotNetMethodCaller reads to find the assembly and the method to call. -->
    <ROW Action="AI_DATA_SETTER" Type="51" Source="WriteMachineConfig" Target="MV_CONNECTIONSTRING=&quot;[MV_CONNECTIONSTRING]&quot;, MV_SERVICEACCOUNT=&quot;[MV_SERVICEACCOUNT]&quot;, MV_URL=&quot;[MV_URL]&quot;, MV_CERT_PATH=&quot;[MV_CERT_PATH]&quot;, MV_CERT_PASSWORD=&quot;[MV_CERT_PASSWORD]&quot;, MV_CERT_THUMBPRINT=&quot;[MV_CERT_THUMBPRINT]&quot;, MV_RECONFIGURE=&quot;[MV_RECONFIGURE]&quot;, MV_PROGRAMDATA=&quot;[CommonAppDataFolder]MiniVault&quot;, APPDIR=&quot;[APPDIR]&quot;;|[&amp;karmasis.minivault.customactions.dl]|Karmasis.MiniVault.CustomActions.InstallActions.WriteMachineConfig"/>
    <ROW Action="AI_DATA_SETTER_1" Type="51" Source="RunInit" Target="MV_RECOVERY=&quot;[MV_RECOVERY]&quot;, MV_SHARES=&quot;[MV_SHARES]&quot;, MV_THRESHOLD=&quot;[MV_THRESHOLD]&quot;, MV_MASTERKEY=&quot;[MV_MASTERKEY]&quot;, MV_PROGRAMDATA=&quot;[CommonAppDataFolder]MiniVault&quot;, APPDIR=&quot;[APPDIR]&quot;;|[&amp;karmasis.minivault.customactions.dl]|Karmasis.MiniVault.CustomActions.InstallActions.RunInit"/>
    <ROW Action="AI_DATA_SETTER_2" Type="51" Source="CustomActionData" Target="|[&amp;karmasis.minivault.customactions.dl]|Karmasis.MiniVault.CustomActions.InstallActions.TestSqlConnection"/>
    <ROW Action="AI_DATA_SETTER_3" Type="51" Source="AI_RemoveAllTempFiles" Target="[AI_TEMP_FILE_ROLLBACK_INFO]"/>
    <ROW Action="AI_DATA_SETTER_4" Type="51" Source="CustomActionData" Target="|[&amp;karmasis.minivault.customactions.dl]|Karmasis.MiniVault.CustomActions.InstallActions.ValidateProperties"/>
    <!-- Type 3073 = 1 (DLL in Binary table) + 1024 (deferred/InScript) + 2048 (NoImpersonate):
         runs in the elevated service context, between InstallFiles and InstallServices. -->
    <ROW Action="WriteMachineConfig" Type="3073" Source="DotNetMethodCaller.dll" Target="CallDotNetMethod" AdditionalSeq="AI_DATA_SETTER"/>
    <ROW Action="RunInit" Type="3073" Source="DotNetMethodCaller.dll" Target="CallDotNetMethod" AdditionalSeq="AI_DATA_SETTER_1"/>
    <!-- Type 65 = 1 (DLL in Binary table) + 64 (ignore the return value): immediate, not sequenced.
         Run by the SqlDlg "Test connection" button (MsiControlEventComponent); it sets MV_SQL_OK
         (1/0) and MV_SQL_ERROR and never fails the installation. -->
    <ROW Action="TestSqlConnection" Type="65" Source="DotNetMethodCaller.dll" Target="CallDotNetMethod" AdditionalSeq="AI_DATA_SETTER_2" WithoutSeq="true"/>
    <!-- Type 1 = DLL in the Binary table, immediate, return value checked: returning Failure aborts the
         installation. Sequenced right after AI_ExtractTempFiles (which is what puts this action's own
         DLL on disk) and before InstallInitialize, so a value that cannot survive CustomActionData
         (anything containing a double quote) is rejected before a single file is installed. -->
    <ROW Action="ValidateProperties" Type="1" Source="DotNetMethodCaller.dll" Target="CallDotNetMethod" AdditionalSeq="AI_DATA_SETTER_4"/>
    <ROW Action="AI_DOWNGRADE" Type="19" Target="4010"/>
    <ROW Action="AI_DoRemoveExternalUIStub" Type="3585" Source="ExternalUICleaner.dll" Target="DoRemoveExternalUIStub" WithoutSeq="true"/>
    <ROW Action="AI_DpiContentScale" Type="1" Source="aicustact.dll" Target="DpiContentScale"/>
    <ROW Action="AI_EnableDebugLog" Type="321" Source="aicustact.dll" Target="EnableDebugLog"/>
    <ROW Action="AI_ExtractTempFiles" Type="1" Source="tempFiles.dll" Target="ExtractTempFiles"/>
    <ROW Action="AI_GetArpIconPath" Type="1" Source="aicustact.dll" Target="GetArpIconPath"/>
    <ROW Action="AI_InstallModeCheck" Type="1" Source="aicustact.dll" Target="UpdateInstallMode" WithoutSeq="true"/>
    <ROW Action="AI_PREPARE_UPGRADE" Type="65" Source="aicustact.dll" Target="PrepareUpgrade"/>
    <ROW Action="AI_PRESERVE_INSTALL_TYPE" Type="65" Source="aicustact.dll" Target="PreserveInstallType"/>
    <ROW Action="AI_RESTORE_LOCATION" Type="65" Source="aicustact.dll" Target="RestoreLocation"/>
    <ROW Action="AI_RemoveAllTempFiles" Type="1281" Source="tempFiles.dll" Target="RemoveAllTempFiles" AdditionalSeq="AI_DATA_SETTER_3"/>
    <ROW Action="AI_RemoveExternalUIStub" Type="1" Source="ExternalUICleaner.dll" Target="RemoveExternalUIStub"/>
    <ROW Action="AI_RemoveTempFiles" Type="1" Source="tempFiles.dll" Target="RemoveTempFiles" WithoutSeq="true"/>
    <ROW Action="AI_ResolveKnownFolders" Type="1" Source="aicustact.dll" Target="AI_ResolveKnownFolders"/>
    <ROW Action="AI_SHOW_LOG" Type="65" Source="aicustact.dll" Target="LaunchLogFile" WithoutSeq="true"/>
    <ROW Action="AI_STORE_LOCATION" Type="51" Source="ARPINSTALLLOCATION" Target="[APPDIR]"/>
    <ROW Action="SET_APPDIR" Type="307" Source="APPDIR" Target="[ProgramFilesFolder]Karmasis\MiniVault" MultiBuildTarget="DefaultBuild:[ProgramFiles64Folder]Karmasis\MiniVault"/>
    <ROW Action="SET_TARGETDIR_TO_APPDIR" Type="51" Source="TARGETDIR" Target="[APPDIR]"/>
  </COMPONENT>
  <!-- ===================================================================================
       Configuration dialogs (first install only): SqlDlg -> ServiceDlg -> TlsDlg -> RecoveryDlg,
       inserted between FolderDlg and VerifyReadyDlg. Authored in XML after the designer-made pages
       in Karmasis.Classic.InfraskopeServer (ConfigureDlg, EsUrlVerifyDlg) and
       Karmasis.Classic.InfraskopeWebService (DatabaseServerDlg, MSMQServerDlg); never opened in the
       designer yet - see ../README.md, "Dialogs". Layout is in dialog units on the classic theme's
       370x270 page: banner 0..44, content 55..228, bottom line at 234, buttons at y=243.
       Control Attributes: 3 = visible+enabled; 65539 = +transparent (Text) / +multiline (Edit);
       196611 = transparent+no-prefix (Text); 2097155 = password (Edit); 19 = integer (Edit);
       1048577 = bitmap. Each page validates on Next: a failing input sets MV_UI_ERROR and spawns
       MvErrorDlg instead of moving on, so the rules mirror MachineConfigWriter/MiniVaultCli without
       relying on control conditions being re-evaluated. [AiRefreshDlg]=1 asks Advanced Installer to
       rebuild the page so Enable/Disable conditions follow the check boxes and the SQL test result.
       =================================================================================== -->
  <COMPONENT cid="caphyon.advinst.msicomp.MsiCheckBoxComponent">
    <!-- MV_RECOVERY is the real installer input: ticked = "shamir", unticked = property cleared, which
         MiniVaultCli.BuildInitArguments treats as "single" (the msiexec default stays "single"). -->
    <ROW Property="MV_RECOVERY" Value="shamir"/>
    <ROW Property="MV_MASTERKEY_USEPASSWORD" Value="1"/>
    <ROW Property="MV_CERT_USEPFX" Value="1"/>
    <ROW Property="MV_RECOVERY_ACK" Value="1"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiDialogComponent">
    <ROW Dialog="SqlDlg" HCentering="50" VCentering="50" Width="370" Height="270" Attributes="3" Title="[ProductName] [Setup]" Control_Default="Next" Control_Cancel="Cancel"/>
    <ROW Dialog="ServiceDlg" HCentering="50" VCentering="50" Width="370" Height="270" Attributes="3" Title="[ProductName] [Setup]" Control_Default="Next" Control_Cancel="Cancel"/>
    <ROW Dialog="TlsDlg" HCentering="50" VCentering="50" Width="370" Height="270" Attributes="3" Title="[ProductName] [Setup]" Control_Default="Next" Control_Cancel="Cancel"/>
    <ROW Dialog="RecoveryDlg" HCentering="50" VCentering="50" Width="370" Height="270" Attributes="3" Title="[ProductName] [Setup]" Control_Default="Next" Control_Cancel="Cancel"/>
    <ROW Dialog="MvErrorDlg" HCentering="50" VCentering="50" Width="300" Height="110" Attributes="3" Title="[ProductName] [Setup]" Control_First="OK" Control_Default="OK" Control_Cancel="OK"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiControlComponent">
    <!-- SqlDlg: MV_CONNECTIONSTRING + "Test connection" (TestSqlConnection -> MV_SQL_OK / MV_SQL_ERROR). -->
    <ROW Dialog_="SqlDlg" Control="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Attributes="1048577" Text="[BannerBitmap]" Order="100"/>
    <ROW Dialog_="SqlDlg" Control="Title" Type="Text" X="12" Y="6" Width="300" Height="15" Attributes="196611" Text="SQL Server connection" TextStyle="[DlgTitleFont]" Order="200"/>
    <ROW Dialog_="SqlDlg" Control="Description" Type="Text" X="12" Y="21" Width="340" Height="20" Attributes="196611" Text="MiniVault stores its data in SQL Server. The master key never goes into this database." Order="300"/>
    <ROW Dialog_="SqlDlg" Control="BannerLine" Type="Line" X="0" Y="44" Width="372" Height="0" Attributes="1" Order="400"/>
    <ROW Dialog_="SqlDlg" Control="CsLabel" Type="Text" X="12" Y="55" Width="340" Height="10" Attributes="3" Text="&amp;Connection string:" Order="500"/>
    <ROW Dialog_="SqlDlg" Control="CsEdit" Type="Edit" X="12" Y="67" Width="348" Height="48" Attributes="65539" Property="MV_CONNECTIONSTRING" Text="{2048}" Order="600"/>
    <ROW Dialog_="SqlDlg" Control="CsHint" Type="Text" X="12" Y="118" Width="348" Height="32" Attributes="196611" Text="Example: Server=sql01;Database=MiniVault;Integrated Security=true. Windows authentication is recommended: no password is stored. With a SQL login, the password is written to %ProgramData%\MiniVault\appsettings.json in plain text (ACL-protected). Do not use double quotes." Order="700"/>
    <ROW Dialog_="SqlDlg" Control="TestButton" Type="PushButton" X="12" Y="154" Width="84" Height="17" Attributes="3" Text="&amp;Test connection" Order="800"/>
    <ROW Dialog_="SqlDlg" Control="TestOk" Type="Text" X="104" Y="157" Width="256" Height="12" Attributes="196611" Text="Connection succeeded." Order="900"/>
    <ROW Dialog_="SqlDlg" Control="TestError" Type="Text" X="12" Y="176" Width="348" Height="50" Attributes="196611" Text="[MV_SQL_ERROR]" Order="1000"/>
    <ROW Dialog_="SqlDlg" Control="BottomLine" Type="Line" X="5" Y="234" Width="370" Height="0" Attributes="1" Order="1100"/>
    <ROW Dialog_="SqlDlg" Control="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Back]" Order="1200" TextLocId="-" Options="1"/>
    <ROW Dialog_="SqlDlg" Control="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Next]" Order="1300" TextLocId="-" Options="1"/>
    <ROW Dialog_="SqlDlg" Control="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Cancel]" Order="1400" TextLocId="-" Options="1"/>
    <!-- ServiceDlg: MV_SERVICEACCOUNT / MV_SERVICEACCOUNT_PASSWORD and the optional MV_MASTERKEY password. -->
    <ROW Dialog_="ServiceDlg" Control="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Attributes="1048577" Text="[BannerBitmap]" Order="100"/>
    <ROW Dialog_="ServiceDlg" Control="Title" Type="Text" X="12" Y="6" Width="300" Height="15" Attributes="196611" Text="Service account and master key" TextStyle="[DlgTitleFont]" Order="200"/>
    <ROW Dialog_="ServiceDlg" Control="Description" Type="Text" X="12" Y="21" Width="340" Height="20" Attributes="196611" Text="The account the MiniVault service runs as, and how its master key is created." Order="300"/>
    <ROW Dialog_="ServiceDlg" Control="BannerLine" Type="Line" X="0" Y="44" Width="372" Height="0" Attributes="1" Order="400"/>
    <ROW Dialog_="ServiceDlg" Control="AccountLabel" Type="Text" X="12" Y="57" Width="120" Height="10" Attributes="3" Text="&amp;Service account:" Order="500"/>
    <ROW Dialog_="ServiceDlg" Control="AccountEdit" Type="Edit" X="135" Y="55" Width="225" Height="16" Attributes="3" Property="MV_SERVICEACCOUNT" Text="{256}" Order="600"/>
    <ROW Dialog_="ServiceDlg" Control="AccountPasswordLabel" Type="Text" X="12" Y="77" Width="120" Height="10" Attributes="3" Text="Account &amp;password:" Order="700"/>
    <ROW Dialog_="ServiceDlg" Control="AccountPasswordEdit" Type="Edit" X="135" Y="75" Width="225" Height="16" Attributes="2097155" Property="MV_SERVICEACCOUNT_PASSWORD" Text="{256}" Order="800"/>
    <ROW Dialog_="ServiceDlg" Control="AccountNote" Type="Text" X="12" Y="94" Width="348" Height="32" Attributes="196611" Text="Leave LocalSystem unless a dedicated account is required. A domain or local account must already hold the 'Log on as a service' right (secpol.msc) - the installer does not grant it - and is given read access to %ProgramData%\MiniVault. For a gMSA enter DOMAIN\name$ and leave the password empty." Order="900"/>
    <ROW Dialog_="ServiceDlg" Control="UsePasswordCheck" Type="CheckBox" X="12" Y="130" Width="348" Height="14" Attributes="3" Property="MV_MASTERKEY_USEPASSWORD" Text="&amp;Derive the master key from a password instead of generating a random one" Order="1000"/>
    <ROW Dialog_="ServiceDlg" Control="MasterKeyLabel" Type="Text" X="24" Y="149" Width="108" Height="10" Attributes="3" Text="&amp;Master key password:" Order="1100"/>
    <ROW Dialog_="ServiceDlg" Control="MasterKeyEdit" Type="Edit" X="135" Y="147" Width="225" Height="16" Attributes="2097155" Property="MV_MASTERKEY" Text="{256}" Order="1200"/>
    <ROW Dialog_="ServiceDlg" Control="MasterKeyConfirmLabel" Type="Text" X="24" Y="169" Width="108" Height="10" Attributes="3" Text="C&amp;onfirm password:" Order="1300"/>
    <ROW Dialog_="ServiceDlg" Control="MasterKeyConfirmEdit" Type="Edit" X="135" Y="167" Width="225" Height="16" Attributes="2097155" Property="MV_MASTERKEY_CONFIRM" Text="{256}" Order="1400"/>
    <ROW Dialog_="ServiceDlg" Control="MasterKeyNote" Type="Text" X="12" Y="187" Width="348" Height="42" Attributes="196611" Text="The password is used once, now, to derive the key; it is not a way back in later. If the master key file is lost, only the recovery material (see the Recovery page) restores the vault. Without this option a random 256-bit key is generated. Do not use double quotes." Order="1500"/>
    <ROW Dialog_="ServiceDlg" Control="BottomLine" Type="Line" X="5" Y="234" Width="370" Height="0" Attributes="1" Order="1600"/>
    <ROW Dialog_="ServiceDlg" Control="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Back]" Order="1700" TextLocId="-" Options="1"/>
    <ROW Dialog_="ServiceDlg" Control="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Next]" Order="1800" TextLocId="-" Options="1"/>
    <ROW Dialog_="ServiceDlg" Control="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Cancel]" Order="1900" TextLocId="-" Options="1"/>
    <!-- TlsDlg: MV_URL and exactly one of MV_CERT_THUMBPRINT (store) or MV_CERT_PATH + MV_CERT_PASSWORD (PFX). -->
    <ROW Dialog_="TlsDlg" Control="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Attributes="1048577" Text="[BannerBitmap]" Order="100"/>
    <ROW Dialog_="TlsDlg" Control="Title" Type="Text" X="12" Y="6" Width="300" Height="15" Attributes="196611" Text="HTTPS certificate" TextStyle="[DlgTitleFont]" Order="200"/>
    <ROW Dialog_="TlsDlg" Control="Description" Type="Text" X="12" Y="21" Width="340" Height="20" Attributes="196611" Text="MiniVault listens on HTTPS only. Choose the server certificate it presents." Order="300"/>
    <ROW Dialog_="TlsDlg" Control="BannerLine" Type="Line" X="0" Y="44" Width="372" Height="0" Attributes="1" Order="400"/>
    <ROW Dialog_="TlsDlg" Control="UrlLabel" Type="Text" X="12" Y="57" Width="120" Height="10" Attributes="3" Text="&amp;Listen URL:" Order="500"/>
    <ROW Dialog_="TlsDlg" Control="UrlEdit" Type="Edit" X="135" Y="55" Width="225" Height="16" Attributes="3" Property="MV_URL" Text="{256}" Order="600"/>
    <ROW Dialog_="TlsDlg" Control="UrlNote" Type="Text" X="12" Y="73" Width="348" Height="12" Attributes="196611" Text="Must start with https:// and use an IP literal (0.0.0.0, ::, localhost or an address), not a DNS name." Order="700"/>
    <ROW Dialog_="TlsDlg" Control="ThumbprintLabel" Type="Text" X="12" Y="91" Width="120" Height="10" Attributes="3" Text="Certificate &amp;thumbprint:" Order="800"/>
    <ROW Dialog_="TlsDlg" Control="ThumbprintEdit" Type="Edit" X="135" Y="89" Width="225" Height="16" Attributes="3" Property="MV_CERT_THUMBPRINT" Text="{64}" Order="900"/>
    <ROW Dialog_="TlsDlg" Control="ThumbprintNote" Type="Text" X="12" Y="107" Width="348" Height="22" Attributes="196611" Text="SHA-1 thumbprint of a certificate that has its private key in Local Computer \ Personal (certlm.msc). If the service account is not LocalSystem, grant it read access to that private key or the service will not start." Order="1000"/>
    <ROW Dialog_="TlsDlg" Control="UsePfxCheck" Type="CheckBox" X="12" Y="133" Width="348" Height="14" Attributes="3" Property="MV_CERT_USEPFX" Text="Use a &amp;PFX file instead of a certificate from the store" Order="1100"/>
    <ROW Dialog_="TlsDlg" Control="PfxPathLabel" Type="Text" X="24" Y="152" Width="108" Height="10" Attributes="3" Text="PFX &amp;file path:" Order="1200"/>
    <ROW Dialog_="TlsDlg" Control="PfxPathEdit" Type="Edit" X="135" Y="150" Width="225" Height="16" Attributes="3" Property="MV_CERT_PATH" Text="{260}" Order="1300"/>
    <ROW Dialog_="TlsDlg" Control="PfxPasswordLabel" Type="Text" X="24" Y="172" Width="108" Height="10" Attributes="3" Text="PFX pass&amp;word:" Order="1400"/>
    <ROW Dialog_="TlsDlg" Control="PfxPasswordEdit" Type="Edit" X="135" Y="170" Width="225" Height="16" Attributes="2097155" Property="MV_CERT_PASSWORD" Text="{256}" Order="1500"/>
    <ROW Dialog_="TlsDlg" Control="PfxNote" Type="Text" X="12" Y="190" Width="348" Height="40" Attributes="196611" Text="The PFX password is stored in plain text in %ProgramData%\MiniVault\appsettings.json (ACL-protected). Prefer the store thumbprint on a Windows host; use a PFX when the same certificate is deployed to several hosts. Do not use double quotes." Order="1600"/>
    <ROW Dialog_="TlsDlg" Control="BottomLine" Type="Line" X="5" Y="234" Width="370" Height="0" Attributes="1" Order="1700"/>
    <ROW Dialog_="TlsDlg" Control="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Back]" Order="1800" TextLocId="-" Options="1"/>
    <ROW Dialog_="TlsDlg" Control="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Next]" Order="1900" TextLocId="-" Options="1"/>
    <ROW Dialog_="TlsDlg" Control="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Cancel]" Order="2000" TextLocId="-" Options="1"/>
    <!-- RecoveryDlg: MV_RECOVERY (single / shamir), MV_SHARES, MV_THRESHOLD, and the "I will copy and delete the file" acknowledgement. -->
    <ROW Dialog_="RecoveryDlg" Control="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Attributes="1048577" Text="[BannerBitmap]" Order="100"/>
    <ROW Dialog_="RecoveryDlg" Control="Title" Type="Text" X="12" Y="6" Width="300" Height="15" Attributes="196611" Text="Recovery material" TextStyle="[DlgTitleFont]" Order="200"/>
    <ROW Dialog_="RecoveryDlg" Control="Description" Type="Text" X="12" Y="21" Width="340" Height="20" Attributes="196611" Text="If the master key is ever lost, the recovery material is the only way to restore the vault." Order="300"/>
    <ROW Dialog_="RecoveryDlg" Control="BannerLine" Type="Line" X="0" Y="44" Width="372" Height="0" Attributes="1" Order="400"/>
    <ROW Dialog_="RecoveryDlg" Control="ShamirCheck" Type="CheckBox" X="12" Y="55" Width="348" Height="14" Attributes="3" Property="MV_RECOVERY" Text="&amp;Split the recovery key into Shamir shares held by different people" Order="500"/>
    <ROW Dialog_="RecoveryDlg" Control="SharesLabel" Type="Text" X="24" Y="75" Width="108" Height="10" Attributes="3" Text="&amp;Number of shares:" Order="600"/>
    <ROW Dialog_="RecoveryDlg" Control="SharesEdit" Type="Edit" X="135" Y="73" Width="50" Height="16" Attributes="19" Property="MV_SHARES" Text="{3}" Order="700"/>
    <ROW Dialog_="RecoveryDlg" Control="ThresholdLabel" Type="Text" X="24" Y="95" Width="108" Height="10" Attributes="3" Text="Shares needed to &amp;recover:" Order="800"/>
    <ROW Dialog_="RecoveryDlg" Control="ThresholdEdit" Type="Edit" X="135" Y="93" Width="50" Height="16" Attributes="19" Property="MV_THRESHOLD" Text="{3}" Order="900"/>
    <ROW Dialog_="RecoveryDlg" Control="ShamirNote" Type="Text" X="12" Y="112" Width="348" Height="22" Attributes="196611" Text="Any 'needed' of the shares restore the vault (2 &lt;= needed &lt;= shares &lt;= 255). Recommended: 3 shares, 2 needed, each stored by a different person. Without this option a single recovery key is produced." Order="1000"/>
    <ROW Dialog_="RecoveryDlg" Control="Warning" Type="Text" X="12" Y="140" Width="348" Height="52" Attributes="196611" Text="IMPORTANT: the recovery material is written ONCE, during installation, to %ProgramData%\MiniVault\recovery-&lt;timestamp&gt;.txt (readable by Administrators only). It cannot be shown again. After setup, open that file, store its contents offline in separate places, then delete the file." Order="1100"/>
    <ROW Dialog_="RecoveryDlg" Control="AckCheck" Type="CheckBox" X="12" Y="196" Width="348" Height="24" Attributes="3" Property="MV_RECOVERY_ACK" Text="&amp;I understand that I must copy the recovery file to a safe offline location and delete it after installation" Order="1200"/>
    <ROW Dialog_="RecoveryDlg" Control="BottomLine" Type="Line" X="5" Y="234" Width="370" Height="0" Attributes="1" Order="1300"/>
    <ROW Dialog_="RecoveryDlg" Control="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Back]" Order="1400" TextLocId="-" Options="1"/>
    <ROW Dialog_="RecoveryDlg" Control="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Next]" Order="1500" TextLocId="-" Options="1"/>
    <ROW Dialog_="RecoveryDlg" Control="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Cancel]" Order="1600" TextLocId="-" Options="1"/>
    <!-- MvErrorDlg: modal message box for the Next-button checks above; the text comes from MV_UI_ERROR. -->
    <ROW Dialog_="MvErrorDlg" Control="Message" Type="Text" X="15" Y="15" Width="270" Height="58" Attributes="196611" Text="[MV_UI_ERROR]" Order="100"/>
    <ROW Dialog_="MvErrorDlg" Control="OK" Type="PushButton" X="122" Y="85" Width="56" Height="17" Attributes="3" Text="[ButtonText_OK]" Order="200" TextLocId="-"/>
    <!-- VerifyReadyDlg: a summary of the choices, shown on a first install only (the standard controls come from the theme fragment). -->
    <ROW Dialog_="VerifyReadyDlg" Control="MvSummaryAccount" Type="Text" X="12" Y="115" Width="348" Height="12" Attributes="196611" Text="Service account: [MV_SERVICEACCOUNT]" Order="2000"/>
    <ROW Dialog_="VerifyReadyDlg" Control="MvSummaryUrl" Type="Text" X="12" Y="129" Width="348" Height="12" Attributes="196611" Text="Listen URL: [MV_URL]" Order="2100"/>
    <ROW Dialog_="VerifyReadyDlg" Control="MvSummaryCert" Type="Text" X="12" Y="143" Width="348" Height="12" Attributes="196611" Text="Certificate: [MV_CERT_THUMBPRINT][MV_CERT_PATH]" Order="2200"/>
    <ROW Dialog_="VerifyReadyDlg" Control="MvSummaryRecoverySingle" Type="Text" X="12" Y="157" Width="348" Height="12" Attributes="196611" Text="Recovery: single recovery key" Order="2300"/>
    <ROW Dialog_="VerifyReadyDlg" Control="MvSummaryRecoveryShamir" Type="Text" X="12" Y="157" Width="348" Height="12" Attributes="196611" Text="Recovery: Shamir shares, [MV_THRESHOLD] of [MV_SHARES] needed" Order="2400"/>
    <ROW Dialog_="VerifyReadyDlg" Control="MvSummaryNote" Type="Text" X="12" Y="175" Width="348" Height="36" Attributes="196611" Text="The recovery material will be written to %ProgramData%\MiniVault\recovery-&lt;timestamp&gt;.txt. The SQL Server connection string is not repeated here because it may contain a password." Order="2500"/>
    <!-- ExitDialog: the one thing the operator must do before walking away. Overlaid on the theme's full-page bitmap, so it starts at x=135 like the standard text. -->
    <ROW Dialog_="ExitDialog" Control="MvRecoveryNote" Type="Text" X="135" Y="105" Width="220" Height="100" Attributes="196611" Text="Before you close this window: open %ProgramData%\MiniVault (Administrators only), copy the contents of recovery-&lt;timestamp&gt;.txt to a safe offline location, then delete the file. It cannot be shown again. Also grant the service account db_datareader and db_datawriter on the MiniVault database if you have not yet (see docs/operations.md)." Order="2000"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiControlConditionComponent">
    <!-- Evaluated when a page is (re)built; the check boxes trigger [AiRefreshDlg]=1 so these follow them. -->
    <ROW Dialog_="SqlDlg" Control_="TestOk" Action="Show" Condition="MV_SQL_OK = &quot;1&quot;"/>
    <ROW Dialog_="SqlDlg" Control_="TestOk" Action="Hide" Condition="MV_SQL_OK &lt;&gt; &quot;1&quot;"/>
    <ROW Dialog_="SqlDlg" Control_="TestError" Action="Show" Condition="MV_SQL_OK &lt;&gt; &quot;1&quot; AND MV_SQL_ERROR &lt;&gt; &quot;&quot;"/>
    <ROW Dialog_="SqlDlg" Control_="TestError" Action="Hide" Condition="MV_SQL_OK = &quot;1&quot; OR MV_SQL_ERROR = &quot;&quot;"/>
    <ROW Dialog_="ServiceDlg" Control_="MasterKeyEdit" Action="Enable" Condition="MV_MASTERKEY_USEPASSWORD = &quot;1&quot;"/>
    <ROW Dialog_="ServiceDlg" Control_="MasterKeyEdit" Action="Disable" Condition="MV_MASTERKEY_USEPASSWORD &lt;&gt; &quot;1&quot;"/>
    <ROW Dialog_="ServiceDlg" Control_="MasterKeyConfirmEdit" Action="Enable" Condition="MV_MASTERKEY_USEPASSWORD = &quot;1&quot;"/>
    <ROW Dialog_="ServiceDlg" Control_="MasterKeyConfirmEdit" Action="Disable" Condition="MV_MASTERKEY_USEPASSWORD &lt;&gt; &quot;1&quot;"/>
    <ROW Dialog_="TlsDlg" Control_="ThumbprintEdit" Action="Enable" Condition="MV_CERT_USEPFX &lt;&gt; &quot;1&quot;"/>
    <ROW Dialog_="TlsDlg" Control_="ThumbprintEdit" Action="Disable" Condition="MV_CERT_USEPFX = &quot;1&quot;"/>
    <ROW Dialog_="TlsDlg" Control_="PfxPathEdit" Action="Enable" Condition="MV_CERT_USEPFX = &quot;1&quot;"/>
    <ROW Dialog_="TlsDlg" Control_="PfxPathEdit" Action="Disable" Condition="MV_CERT_USEPFX &lt;&gt; &quot;1&quot;"/>
    <ROW Dialog_="TlsDlg" Control_="PfxPasswordEdit" Action="Enable" Condition="MV_CERT_USEPFX = &quot;1&quot;"/>
    <ROW Dialog_="TlsDlg" Control_="PfxPasswordEdit" Action="Disable" Condition="MV_CERT_USEPFX &lt;&gt; &quot;1&quot;"/>
    <ROW Dialog_="RecoveryDlg" Control_="SharesEdit" Action="Enable" Condition="MV_RECOVERY = &quot;shamir&quot;"/>
    <ROW Dialog_="RecoveryDlg" Control_="SharesEdit" Action="Disable" Condition="MV_RECOVERY &lt;&gt; &quot;shamir&quot;"/>
    <ROW Dialog_="RecoveryDlg" Control_="ThresholdEdit" Action="Enable" Condition="MV_RECOVERY = &quot;shamir&quot;"/>
    <ROW Dialog_="RecoveryDlg" Control_="ThresholdEdit" Action="Disable" Condition="MV_RECOVERY &lt;&gt; &quot;shamir&quot;"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="MvSummaryAccount" Action="Show" Condition="AI_INSTALL AND NOT OLDPRODUCTS"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="MvSummaryAccount" Action="Hide" Condition="NOT AI_INSTALL OR OLDPRODUCTS"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="MvSummaryUrl" Action="Show" Condition="AI_INSTALL AND NOT OLDPRODUCTS"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="MvSummaryUrl" Action="Hide" Condition="NOT AI_INSTALL OR OLDPRODUCTS"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="MvSummaryCert" Action="Show" Condition="AI_INSTALL AND NOT OLDPRODUCTS"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="MvSummaryCert" Action="Hide" Condition="NOT AI_INSTALL OR OLDPRODUCTS"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="MvSummaryRecoverySingle" Action="Show" Condition="AI_INSTALL AND NOT OLDPRODUCTS AND MV_RECOVERY &lt;&gt; &quot;shamir&quot;"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="MvSummaryRecoverySingle" Action="Hide" Condition="NOT AI_INSTALL OR OLDPRODUCTS OR MV_RECOVERY = &quot;shamir&quot;"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="MvSummaryRecoveryShamir" Action="Show" Condition="AI_INSTALL AND NOT OLDPRODUCTS AND MV_RECOVERY = &quot;shamir&quot;"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="MvSummaryRecoveryShamir" Action="Hide" Condition="NOT AI_INSTALL OR OLDPRODUCTS OR MV_RECOVERY &lt;&gt; &quot;shamir&quot;"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="MvSummaryNote" Action="Show" Condition="AI_INSTALL AND NOT OLDPRODUCTS"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="MvSummaryNote" Action="Hide" Condition="NOT AI_INSTALL OR OLDPRODUCTS"/>
    <ROW Dialog_="ExitDialog" Control_="MvRecoveryNote" Action="Show" Condition="AI_INSTALL AND NOT OLDPRODUCTS"/>
    <ROW Dialog_="ExitDialog" Control_="MvRecoveryNote" Action="Hide" Condition="NOT AI_INSTALL OR OLDPRODUCTS"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiControlEventComponent">
    <!-- Navigation. The theme fragment's own FolderDlg.Next -> VerifyReadyDlg and VerifyReadyDlg.Back ->
         FolderDlg rows (Ordering 201) stay; the rows below run after them (202/203) and the last NewDialog
         wins - the same override the designer produced in Karmasis.Classic.InfraskopeServer. The pages
         are skipped on a major upgrade (OLDPRODUCTS): WriteMachineConfig keeps the existing
         appsettings.json and RunInit treats "already initialized" as a no-op. -->
    <ROW Dialog_="FolderDlg" Control_="Next" Event="NewDialog" Argument="SqlDlg" Condition="AI_INSTALL AND NOT OLDPRODUCTS" Ordering="202"/>
    <ROW Dialog_="FolderDlg" Control_="Next" Event="NewDialog" Argument="VerifyReadyDlg" Condition="AI_INSTALL AND OLDPRODUCTS" Ordering="203"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="Back" Event="NewDialog" Argument="RecoveryDlg" Condition="AI_INSTALL AND NOT OLDPRODUCTS" Ordering="202"/>
    <ROW Dialog_="VerifyReadyDlg" Control_="Back" Event="NewDialog" Argument="FolderDlg" Condition="AI_INSTALL AND OLDPRODUCTS" Ordering="203"/>
    <!-- SqlDlg -->
    <ROW Dialog_="SqlDlg" Control_="Cancel" Event="SpawnDialog" Argument="CancelDlg" Condition="1" Ordering="100"/>
    <ROW Dialog_="SqlDlg" Control_="Back" Event="NewDialog" Argument="FolderDlg" Condition="AI_INSTALL" Ordering="1"/>
    <ROW Dialog_="SqlDlg" Control_="TestButton" Event="DoAction" Argument="AI_DATA_SETTER_2" Condition="AI_INSTALL" Ordering="1"/>
    <ROW Dialog_="SqlDlg" Control_="TestButton" Event="DoAction" Argument="TestSqlConnection" Condition="AI_INSTALL" Ordering="2"/>
    <ROW Dialog_="SqlDlg" Control_="TestButton" Event="[AiRefreshDlg]" Argument="1" Condition="AI_INSTALL" Ordering="3"/>
    <ROW Dialog_="SqlDlg" Control_="Next" Event="[MV_UI_ERROR]" Argument="A connection string is required." Condition="MV_CONNECTIONSTRING = &quot;&quot;" Ordering="1"/>
    <ROW Dialog_="SqlDlg" Control_="Next" Event="SpawnDialog" Argument="MvErrorDlg" Condition="MV_CONNECTIONSTRING = &quot;&quot;" Ordering="2"/>
    <ROW Dialog_="SqlDlg" Control_="Next" Event="NewDialog" Argument="ServiceDlg" Condition="MV_CONNECTIONSTRING &lt;&gt; &quot;&quot;" Ordering="10"/>
    <!-- ServiceDlg -->
    <ROW Dialog_="ServiceDlg" Control_="Cancel" Event="SpawnDialog" Argument="CancelDlg" Condition="1" Ordering="100"/>
    <ROW Dialog_="ServiceDlg" Control_="Back" Event="NewDialog" Argument="SqlDlg" Condition="AI_INSTALL" Ordering="1"/>
    <ROW Dialog_="ServiceDlg" Control_="UsePasswordCheck" Event="[AiRefreshDlg]" Argument="1" Condition="AI_INSTALL" Ordering="1"/>
    <ROW Dialog_="ServiceDlg" Control_="Next" Event="[MV_SERVICEACCOUNT]" Argument="LocalSystem" Condition="MV_SERVICEACCOUNT = &quot;&quot;" Ordering="1"/>
    <ROW Dialog_="ServiceDlg" Control_="Next" Event="[MV_MASTERKEY]" Argument="{}" Condition="MV_MASTERKEY_USEPASSWORD &lt;&gt; &quot;1&quot;" Ordering="2"/>
    <ROW Dialog_="ServiceDlg" Control_="Next" Event="[MV_MASTERKEY_CONFIRM]" Argument="{}" Condition="MV_MASTERKEY_USEPASSWORD &lt;&gt; &quot;1&quot;" Ordering="3"/>
    <ROW Dialog_="ServiceDlg" Control_="Next" Event="[MV_UI_ERROR]" Argument="Enter the master key password, or clear the option to derive the master key from a password." Condition="MV_MASTERKEY_USEPASSWORD = &quot;1&quot; AND MV_MASTERKEY = &quot;&quot;" Ordering="4"/>
    <ROW Dialog_="ServiceDlg" Control_="Next" Event="SpawnDialog" Argument="MvErrorDlg" Condition="MV_MASTERKEY_USEPASSWORD = &quot;1&quot; AND MV_MASTERKEY = &quot;&quot;" Ordering="5"/>
    <ROW Dialog_="ServiceDlg" Control_="Next" Event="[MV_UI_ERROR]" Argument="The master key passwords do not match." Condition="MV_MASTERKEY_USEPASSWORD = &quot;1&quot; AND MV_MASTERKEY &lt;&gt; &quot;&quot; AND MV_MASTERKEY &lt;&gt; MV_MASTERKEY_CONFIRM" Ordering="6"/>
    <ROW Dialog_="ServiceDlg" Control_="Next" Event="SpawnDialog" Argument="MvErrorDlg" Condition="MV_MASTERKEY_USEPASSWORD = &quot;1&quot; AND MV_MASTERKEY &lt;&gt; &quot;&quot; AND MV_MASTERKEY &lt;&gt; MV_MASTERKEY_CONFIRM" Ordering="7"/>
    <ROW Dialog_="ServiceDlg" Control_="Next" Event="NewDialog" Argument="TlsDlg" Condition="MV_MASTERKEY_USEPASSWORD &lt;&gt; &quot;1&quot; OR (MV_MASTERKEY &lt;&gt; &quot;&quot; AND MV_MASTERKEY = MV_MASTERKEY_CONFIRM)" Ordering="10"/>
    <!-- TlsDlg -->
    <ROW Dialog_="TlsDlg" Control_="Cancel" Event="SpawnDialog" Argument="CancelDlg" Condition="1" Ordering="100"/>
    <ROW Dialog_="TlsDlg" Control_="Back" Event="NewDialog" Argument="ServiceDlg" Condition="AI_INSTALL" Ordering="1"/>
    <ROW Dialog_="TlsDlg" Control_="UsePfxCheck" Event="[AiRefreshDlg]" Argument="1" Condition="AI_INSTALL" Ordering="1"/>
    <ROW Dialog_="TlsDlg" Control_="Next" Event="[MV_CERT_THUMBPRINT]" Argument="{}" Condition="MV_CERT_USEPFX = &quot;1&quot;" Ordering="1"/>
    <ROW Dialog_="TlsDlg" Control_="Next" Event="[MV_CERT_PATH]" Argument="{}" Condition="MV_CERT_USEPFX &lt;&gt; &quot;1&quot;" Ordering="2"/>
    <ROW Dialog_="TlsDlg" Control_="Next" Event="[MV_CERT_PASSWORD]" Argument="{}" Condition="MV_CERT_USEPFX &lt;&gt; &quot;1&quot;" Ordering="3"/>
    <ROW Dialog_="TlsDlg" Control_="Next" Event="[MV_UI_ERROR]" Argument="The listen URL is required (for example https://0.0.0.0:8200)." Condition="MV_URL = &quot;&quot;" Ordering="4"/>
    <ROW Dialog_="TlsDlg" Control_="Next" Event="SpawnDialog" Argument="MvErrorDlg" Condition="MV_URL = &quot;&quot;" Ordering="5"/>
    <ROW Dialog_="TlsDlg" Control_="Next" Event="[MV_UI_ERROR]" Argument="Enter the certificate thumbprint, or tick the PFX option and enter a PFX file path." Condition="MV_URL &lt;&gt; &quot;&quot; AND MV_CERT_USEPFX &lt;&gt; &quot;1&quot; AND MV_CERT_THUMBPRINT = &quot;&quot;" Ordering="6"/>
    <ROW Dialog_="TlsDlg" Control_="Next" Event="SpawnDialog" Argument="MvErrorDlg" Condition="MV_URL &lt;&gt; &quot;&quot; AND MV_CERT_USEPFX &lt;&gt; &quot;1&quot; AND MV_CERT_THUMBPRINT = &quot;&quot;" Ordering="7"/>
    <ROW Dialog_="TlsDlg" Control_="Next" Event="[MV_UI_ERROR]" Argument="Enter the PFX file path." Condition="MV_URL &lt;&gt; &quot;&quot; AND MV_CERT_USEPFX = &quot;1&quot; AND MV_CERT_PATH = &quot;&quot;" Ordering="8"/>
    <ROW Dialog_="TlsDlg" Control_="Next" Event="SpawnDialog" Argument="MvErrorDlg" Condition="MV_URL &lt;&gt; &quot;&quot; AND MV_CERT_USEPFX = &quot;1&quot; AND MV_CERT_PATH = &quot;&quot;" Ordering="9"/>
    <ROW Dialog_="TlsDlg" Control_="Next" Event="NewDialog" Argument="RecoveryDlg" Condition="MV_URL &lt;&gt; &quot;&quot; AND ((MV_CERT_USEPFX &lt;&gt; &quot;1&quot; AND MV_CERT_THUMBPRINT &lt;&gt; &quot;&quot;) OR (MV_CERT_USEPFX = &quot;1&quot; AND MV_CERT_PATH &lt;&gt; &quot;&quot;))" Ordering="10"/>
    <!-- RecoveryDlg. The threshold &lt;= shares rule needs a numeric comparison of two properties, which MSI
         conditions cannot do; ValidateProperties (immediate, before InstallInitialize) checks it, so a bad
         pair still fails before anything is installed. -->
    <ROW Dialog_="RecoveryDlg" Control_="Cancel" Event="SpawnDialog" Argument="CancelDlg" Condition="1" Ordering="100"/>
    <ROW Dialog_="RecoveryDlg" Control_="Back" Event="NewDialog" Argument="TlsDlg" Condition="AI_INSTALL" Ordering="1"/>
    <ROW Dialog_="RecoveryDlg" Control_="ShamirCheck" Event="[AiRefreshDlg]" Argument="1" Condition="AI_INSTALL" Ordering="1"/>
    <ROW Dialog_="RecoveryDlg" Control_="Next" Event="[MV_UI_ERROR]" Argument="Shamir shares must be between 2 and 255, and the number needed to recover between 2 and the number of shares." Condition="MV_RECOVERY = &quot;shamir&quot; AND (MV_SHARES = &quot;&quot; OR MV_THRESHOLD = &quot;&quot; OR MV_SHARES &lt; 2 OR MV_SHARES &gt; 255 OR MV_THRESHOLD &lt; 2 OR MV_THRESHOLD &gt; 255)" Ordering="1"/>
    <ROW Dialog_="RecoveryDlg" Control_="Next" Event="SpawnDialog" Argument="MvErrorDlg" Condition="MV_RECOVERY = &quot;shamir&quot; AND (MV_SHARES = &quot;&quot; OR MV_THRESHOLD = &quot;&quot; OR MV_SHARES &lt; 2 OR MV_SHARES &gt; 255 OR MV_THRESHOLD &lt; 2 OR MV_THRESHOLD &gt; 255)" Ordering="2"/>
    <ROW Dialog_="RecoveryDlg" Control_="Next" Event="[MV_UI_ERROR]" Argument="Confirm that you will copy the recovery file to a safe offline location and delete it after installation." Condition="MV_RECOVERY_ACK &lt;&gt; &quot;1&quot;" Ordering="3"/>
    <ROW Dialog_="RecoveryDlg" Control_="Next" Event="SpawnDialog" Argument="MvErrorDlg" Condition="MV_RECOVERY_ACK &lt;&gt; &quot;1&quot;" Ordering="4"/>
    <ROW Dialog_="RecoveryDlg" Control_="Next" Event="NewDialog" Argument="VerifyReadyDlg" Condition="MV_RECOVERY_ACK = &quot;1&quot; AND (MV_RECOVERY &lt;&gt; &quot;shamir&quot; OR (MV_SHARES &gt;= 2 AND MV_SHARES &lt;= 255 AND MV_THRESHOLD &gt;= 2 AND MV_THRESHOLD &lt;= 255))" Ordering="10"/>
    <!-- MvErrorDlg -->
    <ROW Dialog_="MvErrorDlg" Control_="OK" Event="EndDialog" Argument="Return" Condition="1" Ordering="1"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiInstExSeqComponent">
    <ROW Action="AI_DOWNGRADE" Condition="AI_NEWERPRODUCTFOUND AND (UILevel &lt;&gt; 5)" Sequence="210"/>
    <ROW Action="AI_EnableDebugLog" Sequence="51"/>
    <ROW Action="AI_ResolveKnownFolders" Sequence="52"/>
    <ROW Action="AI_RESTORE_LOCATION" Condition="APPDIR=&quot;&quot;" Sequence="749"/>
    <ROW Action="AI_ExtractTempFiles" Sequence="1001"/>
    <!-- Validation must run against the extracted CustomActions DLL, so it is sequenced right after
         AI_ExtractTempFiles (1001) and before InstallInitialize (1500), not immediately after
         LaunchConditions - the DLL used to invoke it does not exist on disk that early. -->
    <ROW Action="AI_DATA_SETTER_4" Sequence="1002"/>
    <ROW Action="ValidateProperties" Sequence="1003"/>
    <ROW Action="AI_PREPARE_UPGRADE" Condition="AI_UPGRADE=&quot;No&quot; AND (Not Installed)" Sequence="1397"/>
    <ROW Action="AI_GetArpIconPath" Sequence="1403"/>
    <ROW Action="AI_DATA_SETTER_3" Sequence="1503"/>
    <ROW Action="AI_RemoveAllTempFiles" Sequence="1504"/>
    <ROW Action="AI_RemoveExternalUIStub" Condition="(REMOVE=&quot;ALL&quot;) AND ((VersionNT &gt; 500) OR((VersionNT = 500) AND (ServicePackLevel &gt;= 4)))" Sequence="1505"/>
    <ROW Action="AI_STORE_LOCATION" Condition="(Not Installed) OR REINSTALL" Sequence="1506"/>
    <!-- Between InstallFiles (4000) and InstallServices (5800)/StartServices (5900): the config file
         and the initialized database must both exist before the service is allowed to start. -->
    <ROW Action="AI_DATA_SETTER" Condition="( NOT Installed )" Sequence="4500"/>
    <ROW Action="WriteMachineConfig" Condition="( NOT Installed )" Sequence="4501"/>
    <ROW Action="AI_DATA_SETTER_1" Condition="( NOT Installed )" Sequence="4502"/>
    <ROW Action="RunInit" Condition="( NOT Installed )" Sequence="4503"/>
    <ROW Action="AI_RemoveTempFiles" Sequence="6601"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiInstallUISequenceComponent">
    <ROW Action="AI_EnableDebugLog" Sequence="51"/>
    <ROW Action="AI_DpiContentScale" Sequence="52"/>
    <ROW Action="AI_ResolveKnownFolders" Sequence="53"/>
    <ROW Action="AI_PRESERVE_INSTALL_TYPE" Sequence="199"/>
    <ROW Action="AI_RESTORE_LOCATION" Condition="APPDIR=&quot;&quot;" Sequence="749"/>
    <ROW Action="AI_ExtractTempFiles" Sequence="1001"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.BootstrapperUISequenceComponent">
    <ROW Action="AI_BACKUP_AI_SETUPEXEPATH" Sequence="249"/>
    <ROW Action="AI_RESTORE_AI_SETUPEXEPATH" Condition="AI_SETUPEXEPATH_ORIGINAL" Sequence="251"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiLaunchConditionsComponent">
    <!-- 64-bit Windows only. Deliberately no .NET Framework condition: the server is published
         self-contained for win-x64, so no runtime has to be present on the target machine. -->
    <ROW Condition="VersionNT64" Description="[ProductName] can only be installed on 64-bit Windows." DescriptionLocId="AI.LaunchCondition.NoNT" IsPredefined="true" Builds="DefaultBuild"/>
    <ROW Condition="(VersionNT &gt;= 603)" Description="[ProductName] requires Windows 8.1 / Windows Server 2012 R2 or later." Builds="DefaultBuild"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiRegsComponent">
    <ROW Registry="Comments" Root="-1" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductName] [ProductVersion]" Name="Comments" Value="[ARPCOMMENTS]" Component_="AI_CustomARPName"/>
    <ROW Registry="DisplayIcon" Root="-1" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductName] [ProductVersion]" Name="DisplayIcon" Value="[ARP_ICON_PATH]" Component_="AI_CustomARPName"/>
    <ROW Registry="DisplayName" Root="-1" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductName] [ProductVersion]" Name="DisplayName" Value="[AI_PRODUCTNAME_ARP]" Component_="AI_CustomARPName"/>
    <ROW Registry="DisplayVersion" Root="-1" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductName] [ProductVersion]" Name="DisplayVersion" Value="[ProductVersion]" Component_="AI_CustomARPName"/>
    <ROW Registry="InstallLocation" Root="-1" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductName] [ProductVersion]" Name="InstallLocation" Value="[APPDIR]" Component_="AI_CustomARPName"/>
    <ROW Registry="Manufacturer" Root="-1" Key="Software\[Manufacturer]" Name="\"/>
    <ROW Registry="Microsoft" Root="-1" Key="Software\Microsoft" Name="\"/>
    <ROW Registry="Path" Root="-1" Key="Software\[Manufacturer]\[ProductName]" Name="Path" Value="[APPDIR]" Component_="ProductInformation"/>
    <ROW Registry="ProductName" Root="-1" Key="Software\[Manufacturer]\[ProductName]" Name="\"/>
    <ROW Registry="ProductNameProductVersion" Root="-1" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductName] [ProductVersion]" Name="\"/>
    <ROW Registry="Publisher" Root="-1" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductName] [ProductVersion]" Name="Publisher" Value="[Manufacturer]" Component_="AI_CustomARPName"/>
    <ROW Registry="Software" Root="-1" Key="Software" Name="\"/>
    <ROW Registry="Uninstall" Root="-1" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall" Name="\"/>
    <ROW Registry="UninstallString" Root="-1" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductName] [ProductVersion]" Name="UninstallString" Value="[AI_UNINSTALLER] /i [ProductCode] AI_UNINSTALLER_CTP=1" Component_="AI_CustomARPName"/>
    <ROW Registry="Version" Root="-1" Key="Software\[Manufacturer]\[ProductName]" Name="Version" Value="[ProductVersion]" Component_="ProductInformation"/>
    <ROW Registry="Windows" Root="-1" Key="Software\Microsoft\Windows" Name="\"/>
    <ROW Registry="CurrentVersion" Root="-1" Key="Software\Microsoft\Windows\CurrentVersion" Name="\"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiUpgradeComponent">
    <ROW UpgradeCode="[|UpgradeCode]" VersionMin="0.0.1" VersionMax="[|ProductVersion]" Attributes="257" ActionProperty="OLDPRODUCTS"/>
    <ROW UpgradeCode="[|UpgradeCode]" VersionMin="[|ProductVersion]" Attributes="2" ActionProperty="AI_NEWERPRODUCTFOUND"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.SynchronizedFolderComponent">
    <!-- The whole self-contained publish output. Produce it before building the MSI with:
             dotnet publish src/MiniVault.Server -p:PublishProfile=win-x64 -->
    <ROW Directory_="APPDIR" SourcePath="..\..\..\src\MiniVault.Server\bin\publish\win-x64" Feature="MainFeature" ExcludePattern="*~|#*#|%*%|._|CVS|.cvsignore|SCCS|vssver.scc|mssccprj.scc|vssver2.scc|.svn|.DS_Store|*.pdb|minivault.exe" ExcludeFlags="6"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiActionTextComponent">
    <ROW Action="ValidateProperties" Description="Checking the MiniVault installer properties" Template="[1]"/>
    <ROW Action="WriteMachineConfig" Description="Writing the MiniVault machine configuration" Template="File: [1]"/>
    <ROW Action="RunInit" Description="Initializing the MiniVault database" Template="[1]"/>
    <ROW Action="AI_ConfigFailActions" Description="Configure service failure actions" DescriptionLocId="ActionText.Description.AI_ConfigFailActions" Template="Service: [1]" TemplateLocId="ActionText.Template.AI_ConfigFailActions"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.MsiThemeComponent">
    <ATTRIBUTE name="UsedTheme" value="classic"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.DictionaryComponent">
    <ROW Path="&lt;AI_DICTS&gt;ui.ail"/>
    <ROW Path="&lt;AI_DICTS&gt;ui_en.ail"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.FragmentComponent">
    <!-- The standard dialog set. The MiniVault configuration pages are the MsiDialogComponent /
         MsiControlComponent rows above; they hook into FolderDlg and VerifyReadyDlg from these fragments. -->
    <ROW Fragment="CommonUI.aip" Path="&lt;AI_FRAGS&gt;CommonUI.aip"/>
    <ROW Fragment="FolderDlg.aip" Path="&lt;AI_THEMES&gt;classic\fragments\FolderDlg.aip"/>
    <ROW Fragment="LicenseAgreementDlg.aip" Path="&lt;AI_THEMES&gt;classic\fragments\LicenseAgreementDlg.aip"/>
    <ROW Fragment="MaintenanceTypeDlg.aip" Path="&lt;AI_THEMES&gt;classic\fragments\MaintenanceTypeDlg.aip"/>
    <ROW Fragment="MaintenanceWelcomeDlg.aip" Path="&lt;AI_THEMES&gt;classic\fragments\MaintenanceWelcomeDlg.aip"/>
    <ROW Fragment="SequenceDialogs.aip" Path="&lt;AI_THEMES&gt;classic\fragments\SequenceDialogs.aip"/>
    <ROW Fragment="Sequences.aip" Path="&lt;AI_FRAGS&gt;Sequences.aip"/>
    <ROW Fragment="StaticUIStrings.aip" Path="&lt;AI_FRAGS&gt;StaticUIStrings.aip"/>
    <ROW Fragment="Themes.aip" Path="&lt;AI_FRAGS&gt;Themes.aip"/>
    <ROW Fragment="UI.aip" Path="&lt;AI_THEMES&gt;classic\fragments\UI.aip"/>
    <ROW Fragment="Validation.aip" Path="&lt;AI_FRAGS&gt;Validation.aip"/>
    <ROW Fragment="VerifyRemoveDlg.aip" Path="&lt;AI_THEMES&gt;classic\fragments\VerifyRemoveDlg.aip"/>
    <ROW Fragment="VerifyRepairDlg.aip" Path="&lt;AI_THEMES&gt;classic\fragments\VerifyRepairDlg.aip"/>
    <ROW Fragment="WelcomeDlg.aip" Path="&lt;AI_THEMES&gt;classic\fragments\WelcomeDlg.aip"/>
  </COMPONENT>
  <COMPONENT cid="caphyon.advinst.msicomp.BuildComponent">
    <ROW BuildKey="DefaultBuild" BuildName="DefaultBuild" BuildOrder="1" BuildType="0" PackageFolder="Setup Files" PackageFileName="Karmasis.MiniVault" Languages="en" InstallationType="4" ExtUI="true" UseLargeSchema="true" MsiPackageType="x64"/>
