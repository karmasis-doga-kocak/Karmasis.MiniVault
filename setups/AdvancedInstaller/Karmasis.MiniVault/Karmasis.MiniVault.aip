  <COMPONENT cid="caphyon.advinst.msicomp.MsiControlComponent">
    <ROW Dialog_="ExitDialog" Control="MvRecoveryNote" Type="Text" X="135" Y="120" Width="220" Height="100" Attributes="196611" Text="Before you close this window: open %ProgramData%\MiniVault (Administrators only), copy the contents of recovery-&lt;timestamp&gt;.txt to a safe offline location, then delete the file. It cannot be shown again. Also grant the service account db_datareader and db_datawriter on the MiniVault database if you have not yet (see docs/operations.md)." Order="1300"/>
    <ROW Dialog_="RecoveryDlg" Control="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" Attributes="1048577" Text="[BannerBitmap]" Order="100"/>
    <ROW Dialog_="RecoveryDlg" Control="Title" Type="Text" X="12" Y="6" Width="300" Height="15" Attributes="196611" Text="Recovery material" TextStyle="[DlgTitleFont]" Order="200"/>
    <ROW Dialog_="RecoveryDlg" Control="Description" Type="Text" X="12" Y="21" Width="340" Height="20" Attributes="196611" Text="If the master key is ever lost, the recovery material is the only way to restore the vault." Order="300"/>
    <ROW Dialog_="RecoveryDlg" Control="BannerLine" Type="Line" X="0" Y="44" Width="372" Height="0" Attributes="1" Order="400"/>
    <ROW Dialog_="RecoveryDlg" Control="ShamirCheck" Type="CheckBox" X="12" Y="55" Width="348" Height="14" Attributes="3" Property="MV_RECOVERY" Text="&amp;Split the recovery key into Shamir shares held by different people" Order="500"/>
    <ROW Dialog_="RecoveryDlg" Control="SharesLabel" Type="Text" X="24" Y="75" Width="108" Height="10" Attributes="3" Text="&amp;Number of shares:" Order="600"/>
    <ROW Dialog_="RecoveryDlg" Control="SharesEdit" Type="Edit" X="135" Y="73" Width="50" Height="16" Attributes="19" Property="MV_SHARES" Text="{3}" Order="700"/>
    <ROW Dialog_="RecoveryDlg" Control="ThresholdLabel" Type="Text" X="24" Y="95" Width="108" Height="10" Attributes="3" Text="Shares needed to &amp;recover:" Order="800"/>
    <ROW Dialog_="RecoveryDlg" Control="ThresholdEdit" Type="Edit" X="135" Y="93" Width="50" Height="16" Attributes="19" Property="MV_THRESHOLD" Text="{3}" Order="900"/>
    <ROW Dialog_="RecoveryDlg" Control="ShamirNote" Type="Text" X="12" Y="112" Width="348" Height="22" Attributes="131075" Text="Any &apos;needed&apos; of the shares restore the vault (2 &lt;= needed &lt;= shares &lt;= 255). Recommended: 3 shares, 2 needed, each stored by a different person. Without this option a single recovery key is produced." Order="1000"/>
    <ROW Dialog_="RecoveryDlg" Control="Warning" Type="Text" X="12" Y="140" Width="348" Height="52" Attributes="131075" Text="IMPORTANT: the recovery material is written ONCE, during installation, to %ProgramData%\MiniVault\recovery-&lt;timestamp&gt;.txt (readable by Administrators only). It cannot be shown again. After setup, open that file, store its contents offline in separate places, then delete the file." Order="1100"/>
    <ROW Dialog_="RecoveryDlg" Control="AckCheck" Type="CheckBox" X="12" Y="196" Width="348" Height="24" Attributes="3" Property="MV_RECOVERY_ACK" Text="&amp;I understand that I must copy the recovery file to a safe offline location and delete it after installation" Order="1200"/>
    <ROW Dialog_="RecoveryDlg" Control="BottomLine" Type="Line" X="5" Y="234" Width="370" Height="0" Attributes="1" Order="1300"/>
