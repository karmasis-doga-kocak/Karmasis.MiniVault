    <ROW Dialog_="TlsDlg" Control="ThumbprintNote" Type="Text" X="12" Y="107" Width="348" Height="22" Attributes="131075" Text="SHA-1 thumbprint of a certificate that has its private key in Local Computer \ Personal (certlm.msc). If the service account is not LocalSystem, grant it read access to that private key or the service will not start." Order="1000"/>
    <ROW Dialog_="TlsDlg" Control="UsePfxCheck" Type="CheckBox" X="12" Y="133" Width="348" Height="14" Attributes="3" Property="MV_CERT_USEPFX" Text="Use a &amp;PFX file instead of a certificate from the store" Order="1100"/>
