    <ROW Dialog_="RecoveryDlg" Control="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Attributes="3" Text="[ButtonText_Cancel]" Order="1600" TextLocId="-" Options="1"/>
