    <ROW Dialog_="TlsDlg" Control="Title" Type="Text" X="12" Y="6" Width="300" Height="15" Attributes="196611" Text="HTTPS certificate" TextStyle="[DlgTitleFont]" Order="200"/>
    <ROW Dialog_="TlsDlg" Control="Description" Type="Text" X="12" Y="21" Width="340" Height="20" Attributes="196611" Text="MiniVault listens on HTTPS only. Choose the server certificate it presents." Order="300"/>
    <ROW Dialog_="TlsDlg" Control="BannerLine" Type="Line" X="0" Y="44" Width="372" Height="0" Attributes="1" Order="400"/>
    <ROW Dialog_="TlsDlg" Control="UrlLabel" Type="Text" X="12" Y="57" Width="120" Height="10" Attributes="3" Text="&amp;Listen URL:" Order="500"/>
