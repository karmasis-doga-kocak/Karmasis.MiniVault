<?xml version="1.0" encoding="utf-8"?>
<!--
  Developer config: nuget.org plus the local folder feed (..\..\local-nuget, i.e.
  D:\Karmasis\local-nuget for a checkout at D:\Karmasis\repos\Karmasis.MiniVault), which is
  where the prerelease Karmasis.Cryptography 26.3.0-dek.1 currently lives (see
  docs/client.md, "Release prerequisites" - it is the only version with a netstandard2.0
  target). That path is outside the repo and does not exist on a build agent, so CI does NOT
  use this file: it restores with nuget-dev.config (dev/feature branches) or
  nuget-release.config (master) instead - see azure-pipelines.yml. Karmasis.Cryptography must
  be published to the artifactrepo/artifactrepodev feeds those files reference before CI can
  restore this solution.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="karmasis-local" value="..\..\local-nuget" />
  </packageSources>
</configuration>
