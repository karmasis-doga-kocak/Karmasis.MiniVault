<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet config used by the CI pipeline (azure-pipelines.yml) to restore on master. Mirrors
  Karmasis.Cryptography's master-branch restore: nuget.org plus only the release Karmasis
  private feed (artifactrepo) - no artifactrepodev, and no local folder feed (the developer
  "karmasis-local" feed in the root nuget.config points outside the repo and does not exist
  on a build agent).

  NOTE: as of this branch, Karmasis.MiniVault.Client references Karmasis.Cryptography
  26.3.0-dek.1, which is only published to the local folder feed (see docs/client.md,
  "Release prerequisites"). Restoring this solution with this config will FAIL until a
  stable Karmasis.Cryptography with a netstandard2.0 target is pushed to artifactrepo. See
  the top-of-file note in azure-pipelines.yml.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="artifactrepo" value="https://pkgs.dev.azure.com/karmasisdm/_packaging/artifactrepo/nuget/v3/index.json" />
  </packageSources>
</configuration>
