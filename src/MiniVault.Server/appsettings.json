{
  "ConnectionStrings": {
    "MiniVault": "Server=(localdb)\\MSSQLLocalDB;Database=MiniVault;Integrated Security=true;TrustServerCertificate=true"
  },
  "MasterKey": {
    "Provider": "Dpapi"
  },
  "Tls": {
    "Url": "https://0.0.0.0:8200",
    "Certificate": {
      "Path": null,
      "Password": null,
      "Thumbprint": null,
      "StoreName": "My",
      "StoreLocation": "LocalMachine"
    },
    "AllowDevelopmentCertificate": false
  },
  "Token": {
    "LifetimeMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
