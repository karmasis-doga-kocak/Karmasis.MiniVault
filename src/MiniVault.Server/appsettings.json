{
  "ConnectionStrings": {
    "MiniVault": "Server=(localdb)\\MSSQLLocalDB;Database=MiniVault;Integrated Security=true;TrustServerCertificate=true"
  },
  "MasterKey": {
    "Provider": "Dpapi"
  },
  "Token": {
    "LifetimeMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
