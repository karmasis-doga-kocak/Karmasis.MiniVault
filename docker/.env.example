# Copy to docker/.env and fill in real values before running
# `docker compose -f docker/docker-compose.yml --env-file docker/.env ...`.
# Never commit the filled-in .env file.

# SQL Server connection string used by both the init job and the server.
# MiniVault's SQL Server is external to this compose file - point it at a host
# instance (from inside a Linux container, the host is reachable as
# host.docker.internal on Docker Desktop) or another container/server you manage.
# Example against a host SQL Server listening on 1433:
#   Server=host.docker.internal,1433;Database=MiniVault;User Id=sa;Password=<sa-password>;TrustServerCertificate=true
CONNECTIONSTRINGS__MINIVAULT=Server=host.docker.internal,1433;Database=MiniVault;User Id=sa;Password=change-me;TrustServerCertificate=true

# Master key, base64-encoded 32 bytes, as printed by `minivault-init` on first run
# (MasterKey__Provider=Environment cannot store the key itself, so init prints:
# "Master key (set as MINIVAULT__MASTERKEY ...): <base64>"). Required by the
# `minivault` service; not used by `minivault-init`.
MINIVAULT__MASTERKEY=

# Password protecting the TLS certificate PFX mounted at /certs/minivault.pfx
# (see docker/README.md for how to generate a self-signed one for local/dev use).
TLS_CERTIFICATE_PASSWORD=change-me
