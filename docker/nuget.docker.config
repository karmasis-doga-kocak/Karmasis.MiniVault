<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet config used inside the Docker build stage.

  The repo's root nuget.config points at "..\..\local-nuget" (a folder feed that only
  exists on the developer's machine, outside the build context). That path cannot be
  resolved inside the container, so the Docker build stage uses this config instead:
  it restores Karmasis.Cryptography from a "local-packages" folder feed that is
  populated (by docker/build-local.ps1) with the .nupkg copied into ./packages before
  `docker build` runs, and that directory is COPYed to /src/packages in the image.

  CI does not use this file for the private feed: it builds with a build arg
  NUGET_CONFIG=nuget-dev.config (added in a later task) so that private
  packages are pulled from the real feed via NUGET_AUTH_TOKEN and
  VSS_NUGET_EXTERNAL_FEED_ENDPOINTS instead of a folder of nupkgs baked into the image.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-packages" value="/src/packages" />
  </packageSources>
</configuration>
